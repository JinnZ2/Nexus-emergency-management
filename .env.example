# AI Providers - configure one or more. The server tries them in order
# and automatically fails over to the next if one goes down.
# All keys are server-side only (server/api.ts) - never exposed to the client.

# Gemini (primary) - https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Claude / Anthropic (failover) - https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# OpenAI (failover) - https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# API_PORT: Port for the Express API proxy server (default: 3001).
API_PORT=3001

# APP_URL: The URL where this app is hosted (used for self-referential links).
APP_URL="http://localhost:3000"
