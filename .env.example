# GEMINI_API_KEY: Required for AI Assistant functionality.
# Get your key from https://aistudio.google.com/apikey
# Used server-side only (server/api.ts) - never exposed to the client.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# API_PORT: Port for the Express API proxy server (default: 3001).
API_PORT=3001

# APP_URL: The URL where this app is hosted (used for self-referential links).
APP_URL="http://localhost:3000"
